generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model PersonalFavorite {
  userId     String
  objectKind FavoriteObjectKind
  objectId   String
  createdAt  DateTime           @default(now())
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, objectKind, objectId])
  @@index([userId, createdAt])
}

model User {
  id                                                                                            String                                @id @default(cuid())
  email                                                                                         String                                @unique
  name                                                                                          String?
  role                                                                                          String                                @default("OWNER")
  createdAt                                                                                     DateTime                              @default(now())
  goodissimaIdentityId                                                                          String?                               @unique
  aiEvents                                                                                      AIEvent[]
  communicationSessions                                                                         CommunicationSession[]
  ContactRequest_ContactRequest_decidedByUserIdToUser                                           ContactRequest[]                      @relation("ContactRequest_decidedByUserIdToUser")
  ContactRequest_ContactRequest_requesterOwnerIdToUser                                          ContactRequest[]                      @relation("ContactRequest_requesterOwnerIdToUser")
  ContactRequest_ContactRequest_targetOwnerIdToUser                                             ContactRequest[]                      @relation("ContactRequest_targetOwnerIdToUser")
  contactRequestEvents                                                                          ContactRequestEvent[]
  directoryProfilesManaged                                                                      DirectoryProfileManager[]
  links                                                                                         GLink[]
  governedJourneys                                                                              GovernedJourney[]
  governedJourneyConsentDecisions                                                               GovernedJourneyConsent[]              @relation("GovernedJourneyConsentDecider")
  governedJourneyConsentEvents                                                                  GovernedJourneyConsentEvent[]         @relation("GovernedJourneyConsentEventActor")
  governedJourneyInvitations                                                                    GovernedJourneyInvitation[]           @relation("GovernedJourneyInvitationInvitee")
  GovernedJourneyCreationRequest                                                                GovernedJourneyCreationRequest[]
  GovernedJourneyEvent                                                                          GovernedJourneyEvent[]
  GovernedJourneyMemoryRoleAssignment_GovernedJourneyMemoryRoleAssignment_grantedByUserIdToUser GovernedJourneyMemoryRoleAssignment[] @relation("GovernedJourneyMemoryRoleAssignment_grantedByUserIdToUser")
  GovernedJourneyMemoryRoleAssignment_GovernedJourneyMemoryRoleAssignment_userIdToUser          GovernedJourneyMemoryRoleAssignment[] @relation("GovernedJourneyMemoryRoleAssignment_userIdToUser")
  GovernedJourneyRelationCase                                                                   GovernedJourneyRelationCase[]
  authorizedMeetingParticipants                                                                 GovernedMeetingParticipant[]          @relation("MeetingParticipantAuthorizer")
  GovernedMemoryAccessGrant_GovernedMemoryAccessGrant_grantedByUserIdToUser                     GovernedMemoryAccessGrant[]           @relation("GovernedMemoryAccessGrant_grantedByUserIdToUser")
  GovernedMemoryAccessGrant_GovernedMemoryAccessGrant_revokedByUserIdToUser                     GovernedMemoryAccessGrant[]           @relation("GovernedMemoryAccessGrant_revokedByUserIdToUser")
  GovernedMemoryAccessGrant_GovernedMemoryAccessGrant_subjectUserIdToUser                       GovernedMemoryAccessGrant[]           @relation("GovernedMemoryAccessGrant_subjectUserIdToUser")
  GovernedMemoryCreationRequest                                                                 GovernedMemoryCreationRequest[]
  GovernedMemoryDecision_GovernedMemoryDecision_decidedByUserIdToUser                           GovernedMemoryDecision[]              @relation("GovernedMemoryDecision_decidedByUserIdToUser")
  GovernedMemoryDecision_GovernedMemoryDecision_validatedByUserIdToUser                         GovernedMemoryDecision[]              @relation("GovernedMemoryDecision_validatedByUserIdToUser")
  GovernedMemoryDispute_GovernedMemoryDispute_raisedByUserIdToUser                              GovernedMemoryDispute[]               @relation("GovernedMemoryDispute_raisedByUserIdToUser")
  GovernedMemoryDispute_GovernedMemoryDispute_resolvedByUserIdToUser                            GovernedMemoryDispute[]               @relation("GovernedMemoryDispute_resolvedByUserIdToUser")
  memoryEvents                                                                                  GovernedMemoryEvent[]
  GovernedMemoryFact_GovernedMemoryFact_authorUserIdToUser                                      GovernedMemoryFact[]                  @relation("GovernedMemoryFact_authorUserIdToUser")
  GovernedMemoryFact_GovernedMemoryFact_establishedByUserIdToUser                               GovernedMemoryFact[]                  @relation("GovernedMemoryFact_establishedByUserIdToUser")
  createdMemoryRelations                                                                        GovernedMemoryRelation[]
  GovernedMemoryRoleAssignment_GovernedMemoryRoleAssignment_assignedByUserIdToUser              GovernedMemoryRoleAssignment[]        @relation("GovernedMemoryRoleAssignment_assignedByUserIdToUser")
  GovernedMemoryRoleAssignment_GovernedMemoryRoleAssignment_revokedByUserIdToUser               GovernedMemoryRoleAssignment[]        @relation("GovernedMemoryRoleAssignment_revokedByUserIdToUser")
  GovernedMemoryRoleAssignment_GovernedMemoryRoleAssignment_userIdToUser                        GovernedMemoryRoleAssignment[]        @relation("GovernedMemoryRoleAssignment_userIdToUser")
  GovernedMemorySource                                                                          GovernedMemorySource[]
  GovernedMemoryTransitionRequest_GovernedMemoryTransitionRequest_requesterUserIdToUser         GovernedMemoryTransitionRequest[]     @relation("GovernedMemoryTransitionRequest_requesterUserIdToUser")
  GovernedMemoryTransitionRequest_GovernedMemoryTransitionRequest_targetUserIdToUser            GovernedMemoryTransitionRequest[]     @relation("GovernedMemoryTransitionRequest_targetUserIdToUser")
  memoryValidations                                                                             GovernedMemoryValidation[]
  manualTemplateEditAudits                                                                      ManualTemplateEditAudit[]
  matchingExecutionLeases                                                                       MatchingExecutionLease[]
  matchingRuns                                                                                  MatchingRun[]                         @relation("MatchingRunOwner")
  notifications                                                                                 Notification[]
  personalFavorites                                                                             PersonalFavorite[]
  portfolios                                                                                    Portfolio[]                           @relation("OwnerPortfolios")
  productFeedback                                                                               ProductFeedback[]
  cases                                                                                         RelationCase[]                        @relation("OwnerCases")
  Representation                                                                                Representation[]
  RepresentationContact                                                                         RepresentationContact[]
  representationContactEvents                                                                   RepresentationContactEvent[]
  templateCriticReports                                                                         TemplateCriticReport[]
  templateGenerations                                                                           TemplateGeneration[]
  templateOptimizations                                                                         TemplateOptimization[]
  goodissimaIdentity                                                                            GoodissimaIdentity?                   @relation(fields: [goodissimaIdentityId], references: [id])
  notificationPreferences                                                                       UserNotificationPreference?
  workspaces                                                                                    Workspace[]                           @relation("OwnerWorkspaces")

  @@unique([id, goodissimaIdentityId])
}

model Portfolio {
  id          String          @id @default(cuid())
  ownerId     String
  slug        String
  name        String
  description String?
  kind        PortfolioKind   @default(OTHER)
  status      PortfolioStatus @default(ACTIVE)
  metadata    Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  owner       User            @relation("OwnerPortfolios", fields: [ownerId], references: [id], onDelete: Cascade)
  workspaces  Workspace[]

  @@unique([ownerId, slug])
  @@index([ownerId, status, createdAt])
  @@index([ownerId, kind, status])
}

model Workspace {
  id                              String                           @id @default(cuid())
  ownerId                         String
  slug                            String
  name                            String
  description                     String?
  kind                            WorkspaceKind                    @default(GOVERNANCE)
  status                          WorkspaceStatus                  @default(ACTIVE)
  metadata                        Json?
  createdAt                       DateTime                         @default(now())
  updatedAt                       DateTime                         @updatedAt
  category                        WorkspaceCategory                @default(OTHER)
  portfolioId                     String?
  communicationSessions           CommunicationSession[]
  links                           GLink[]
  governedJourneyCreationRequests GovernedJourneyCreationRequest[]
  governedJourneyInvitations      GovernedJourneyInvitation[]
  relationCases                   RelationCase[]
  relationTemplates               RelationTemplate[]
  owner                           User                             @relation("OwnerWorkspaces", fields: [ownerId], references: [id], onDelete: Cascade)
  portfolio                       Portfolio?                       @relation(fields: [portfolioId], references: [id])

  @@unique([ownerId, slug])
  @@index([portfolioId])
  @@index([ownerId, status, createdAt])
  @@index([ownerId, category, status])
  @@index([kind, status])
}

model GovernedJourneyInvitation {
  id                   String                          @id @default(cuid())
  ownerId              String
  workspaceId          String?
  relationTemplateId   String
  relationCaseId       String?
  displayName          String
  role                 GovernedJourneyInvitationRole
  status               GovernedJourneyInvitationStatus @default(ACTIVE)
  accessTokenHash      String                          @unique
  accessTokenExpiresAt DateTime
  revokedAt            DateTime?
  acceptedAt           DateTime?
  lastAccessedAt       DateTime?
  inviteeUserId        String?
  metadata             Json?
  createdAt            DateTime                        @default(now())
  updatedAt            DateTime                        @updatedAt
  relationCase         RelationCase?                   @relation(fields: [relationCaseId], references: [id])
  relationTemplate     RelationTemplate                @relation(fields: [relationTemplateId], references: [id], onDelete: Cascade)
  workspace            Workspace?                      @relation(fields: [workspaceId], references: [id])
  inviteeUser          User?                           @relation("GovernedJourneyInvitationInvitee", fields: [inviteeUserId], references: [id], onDelete: SetNull)
  consent              GovernedJourneyConsent?
  consentEvents        GovernedJourneyConsentEvent[]
  meetingParticipants  GovernedMeetingParticipant[]

  @@index([ownerId, relationTemplateId, status])
  @@index([accessTokenExpiresAt, status])
  @@index([inviteeUserId, status, createdAt])
}

/// Explicit Journey consent is distinct from invitation delivery, access and meeting participation.
/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model GovernedJourneyConsent {
  id              String                        @id @default(cuid())
  invitationId    String                        @unique
  status          JourneyConsentStatus          @default(PENDING)
  decidedAt       DateTime?
  decidedByUserId String?
  version         Int                           @default(0)
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt
  invitation      GovernedJourneyInvitation     @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  decidedByUser   User?                         @relation("GovernedJourneyConsentDecider", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  events          GovernedJourneyConsentEvent[]

  @@index([status, updatedAt])
}

/// Append-only audit journal for explicit Journey consent transitions.
model GovernedJourneyConsentEvent {
  id             String                          @id @default(cuid())
  invitationId   String
  consentId      String?
  type           GovernedJourneyConsentEventType
  actorUserId    String?
  actorKind      GovernedJourneyConsentActorKind
  occurredAt     DateTime
  consentVersion Int?
  roleSnapshot   GovernedJourneyInvitationRole?
  createdAt      DateTime                        @default(now())
  invitation     GovernedJourneyInvitation       @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  consent        GovernedJourneyConsent?         @relation(fields: [consentId], references: [id], onDelete: Restrict)
  actorUser      User?                           @relation("GovernedJourneyConsentEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([invitationId, occurredAt, id])
  @@index([consentId, occurredAt, id])
}

model CommunicationSession {
  id                        String                       @id @default(cuid())
  ownerId                   String
  workspaceId               String?
  relationTemplateId        String?
  relationCaseId            String?
  channelType               CommunicationChannelType
  provider                  CommunicationProvider
  status                    CommunicationSessionStatus
  title                     String
  purpose                   String?
  note                      String?
  externalUrl               String?
  scheduledAt               DateTime?
  expiresAt                 DateTime?
  transcriptionRequested    Boolean                      @default(false)
  transcriptionConsented    Boolean                      @default(false)
  recordingEnabled          Boolean                      @default(false)
  automaticNotificationSent Boolean                      @default(false)
  tokenGenerated            Boolean                      @default(false)
  accessOpened              Boolean                      @default(false)
  workflowStarted           Boolean                      @default(false)
  createdAt                 DateTime                     @default(now())
  updatedAt                 DateTime                     @updatedAt
  metadata                  Json?
  owner                     User                         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  relationCase              RelationCase?                @relation(fields: [relationCaseId], references: [id])
  relationTemplate          RelationTemplate?            @relation(fields: [relationTemplateId], references: [id])
  workspace                 Workspace?                   @relation(fields: [workspaceId], references: [id])
  meetingParticipants       GovernedMeetingParticipant[]

  @@index([ownerId, status, createdAt])
  @@index([workspaceId, status])
  @@index([relationTemplateId, status])
  @@index([relationCaseId, status])
  @@index([channelType, status])
}

model GovernedMeetingParticipant {
  id                          String                           @id @default(cuid())
  communicationSessionId      String
  governedJourneyInvitationId String
  status                      GovernedMeetingParticipantStatus @default(AUTHORIZED)
  authorizedAt                DateTime                         @default(now())
  removedAt                   DateTime?
  authorizedById              String?
  metadata                    Json?
  createdAt                   DateTime                         @default(now())
  updatedAt                   DateTime                         @updatedAt
  authorizedBy                User?                            @relation("MeetingParticipantAuthorizer", fields: [authorizedById], references: [id])
  communicationSession        CommunicationSession             @relation(fields: [communicationSessionId], references: [id], onDelete: Cascade)
  governedJourneyInvitation   GovernedJourneyInvitation        @relation(fields: [governedJourneyInvitationId], references: [id], onDelete: Cascade)

  @@unique([communicationSessionId, governedJourneyInvitationId], map: "GovernedMeetingParticipant_communicationSessionId_governedJourn")
  @@index([governedJourneyInvitationId, status], map: "GovernedMeetingParticipant_governedJourneyInvitationId_status_i")
}

model AccessInvitation {
  id              String                 @id @default(cuid())
  email           String                 @unique
  invitedByUserId String?
  status          AccessInvitationStatus @default(PENDING)
  note            String?
  token           String?
  expiresAt       DateTime?
  acceptedAt      DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([status, createdAt])
}

model UserNotificationPreference {
  id                        String   @id @default(cuid())
  userId                    String   @unique
  emailNotificationsEnabled Boolean  @default(false)
  newMessagesEnabled        Boolean  @default(false)
  newRequestsEnabled        Boolean  @default(false)
  newDocumentsEnabled       Boolean  @default(false)
  validationsEnabled        Boolean  @default(false)
  relationalPrivacyEnabled  Boolean  @default(true)
  pseudonymizationEnabled   Boolean  @default(true)
  frequency                 String   @default("IMMEDIATE")
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GLink {
  id                String            @id @default(cuid())
  ownerId           String
  workspaceId       String?
  templateId        String?
  templateVersionId String?
  slug              String            @unique
  title             String
  city              String?
  description       String?
  rules             Json?
  status            LinkStatus        @default(ACTIVE)
  admissionMode     LinkAdmissionMode @default(OPEN)
  createdAt         DateTime          @default(now())
  expiresAt         DateTime?

  owner                      User                        @relation(fields: [ownerId], references: [id])
  workspace                  Workspace?                  @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  template                   RelationTemplate?           @relation(fields: [templateId], references: [id])
  templateVersion            TemplateVersion?            @relation(fields: [templateVersionId], references: [id])
  cases                      RelationCase[]
  trustPolicies              TrustPolicy[]
  trustAdmissionTokens       TrustAdmissionToken[]
  matchingRuns               MatchingRun[]               @relation("MatchingRunSourceGLink")
  matchingResults            MatchingResult[]            @relation("MatchingResultTargetGLink")
  publicCaseCreationRequests PublicCaseCreationRequest[]
  matchingExecutionLeases    MatchingExecutionLease[]

  @@index([workspaceId])
}

model RelationCase {
  id                                 String                            @id @default(cuid())
  gLinkId                            String
  ownerId                            String
  candidateName                      String
  candidateEmail                     String
  status                             RelationStatus                    @default(NEW)
  createdAt                          DateTime                          @default(now())
  closedAt                           DateTime?
  candidateAccessToken               String                            @unique
  candidateAccessExpiresAt           DateTime?
  candidateAccessRevokedAt           DateTime?
  priority                           RelationPriority                  @default(NORMAL)
  templateId                         String?
  currentStep                        String?                           @default("CONVERSATION")
  candidateEmailNotificationsEnabled Boolean                           @default(false)
  matchingEnabled                    Boolean                           @default(false)
  embeddingStatus                    String                            @default("fresh")
  embeddingUpdatedAt                 DateTime?
  governanceStatus                   RelationGovernanceStatus          @default(ACTIVE)
  governanceUpdatedAt                DateTime?
  governanceReason                   String?
  candidateIdentityId                String?
  workspaceId                        String?
  aiEvents                           AIEvent[]
  auditLogs                          AuditLog[]
  communicationSessions              CommunicationSession[]
  documents                          Document[]
  embeddingJobs                      EmbeddingJob[]
  formSubmissions                    FormSubmission[]
  governedJourneys                   GovernedJourney[]
  governedJourneyInvitations         GovernedJourneyInvitation[]
  governedJourneyContexts            GovernedJourneyRelationCase?
  memoryAccessGrants                 GovernedMemoryAccessGrant[]
  governedMemoryCreationRequests     GovernedMemoryCreationRequest[]
  memoryDecisions                    GovernedMemoryDecision[]
  memoryDisputes                     GovernedMemoryDispute[]
  memoryEvents                       GovernedMemoryEvent[]
  memoryFacts                        GovernedMemoryFact[]
  memoryRelations                    GovernedMemoryRelation[]
  memoryRoleAssignments              GovernedMemoryRoleAssignment[]
  memorySources                      GovernedMemorySource[]
  governedMemoryTransitionRequests   GovernedMemoryTransitionRequest[]
  memoryValidations                  GovernedMemoryValidation[]
  matchingResults                    MatchingResult[]
  messages                           Message[]
  notifications                      Notification[]
  productFeedback                    ProductFeedback[]
  publicCaseCreationRequests         PublicCaseCreationRequest[]
  relationActions                    RelationAction[]
  candidateIdentity                  GoodissimaIdentity?               @relation(fields: [candidateIdentityId], references: [id])
  gLink                              GLink                             @relation(fields: [gLinkId], references: [id])
  owner                              User                              @relation("OwnerCases", fields: [ownerId], references: [id])
  template                           RelationTemplate?                 @relation(fields: [templateId], references: [id])
  workspace                          Workspace?                        @relation(fields: [workspaceId], references: [id])
  embeddings                         RelationEmbedding[]
  relationEvents                     RelationEvent[]
  trustPolicies                      TrustPolicy[]

  @@unique([id, ownerId])
  @@unique([id, templateId])
  @@index([governanceStatus])
  @@index([candidateIdentityId])
  @@index([workspaceId])
}

model MatchingRun {
  id                      String            @id @default(cuid())
  gLinkId                 String
  ownerId                 String
  status                  MatchingRunStatus @default(PREPARED)
  isPaused                Boolean           @default(false)
  engineVersion           String
  criteriaSnapshot        Json
  startedAt               DateTime?
  completedAt             DateTime?
  failedAt                DateTime?
  pausedAt                DateTime?
  closedAt                DateTime?
  failureCode             String?
  idempotencyKey          String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  criteriaFingerprintHash String?
  cacheValidUntil         DateTime?
  results                 MatchingResult[]
  gLink                   GLink             @relation("MatchingRunSourceGLink", fields: [gLinkId], references: [id])
  owner                   User              @relation("MatchingRunOwner", fields: [ownerId], references: [id])

  @@unique([ownerId, idempotencyKey])
  @@index([gLinkId, createdAt])
  @@index([ownerId, status])
  @@index([ownerId, isPaused])
  @@index([cacheValidUntil])
  @@index([createdAt])
  @@index([ownerId, gLinkId, criteriaFingerprintHash, createdAt], map: "MatchingRun_ownerId_gLinkId_criteriaFingerprintHash_createdAt_i")
}

model MatchingExecutionLease {
  id                      String   @id @default(cuid())
  ownerId                 String
  gLinkId                 String
  criteriaFingerprintHash String
  expiresAt               DateTime
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  gLink                   GLink    @relation(fields: [gLinkId], references: [id], onDelete: Cascade)
  owner                   User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, gLinkId, criteriaFingerprintHash], map: "MatchingExecutionLease_ownerId_gLinkId_criteriaFingerprintHash_")
  @@index([expiresAt])
}

model MatchingResult {
  id             String               @id @default(cuid())
  runId          String
  targetGLinkId  String
  status         MatchingResultStatus @default(AVAILABLE)
  explanation    Json
  internalRank   Int?
  selectedAt     DateTime?
  dismissedAt    DateTime?
  linkedAt       DateTime?
  relationCaseId String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  run          MatchingRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  targetGLink  GLink         @relation("MatchingResultTargetGLink", fields: [targetGLinkId], references: [id], onDelete: Restrict)
  relationCase RelationCase? @relation(fields: [relationCaseId], references: [id], onDelete: SetNull)

  @@unique([runId, targetGLinkId])
  @@index([runId, status])
  @@index([targetGLinkId])
  @@index([relationCaseId])
}

model EmbeddingJob {
  id             String       @id @default(cuid())
  relationCaseId String
  status         String       @default("pending")
  triggerType    String
  attempts       Int          @default(0)
  lastError      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  processedAt    DateTime?
  relationCase   RelationCase @relation(fields: [relationCaseId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([relationCaseId, status])
}

model RelationEmbedding {
  id             String                 @id @default(cuid())
  relationCaseId String
  embeddingType  String
  contentHash    String
  vector         Unsupported("vector")?
  createdAt      DateTime               @default(now())
  relationCase   RelationCase           @relation(fields: [relationCaseId], references: [id], onDelete: Cascade)

  @@index([relationCaseId, embeddingType])
  @@index([contentHash])
  @@index([vector], map: "RelationEmbedding_vector_cosine_idx")
}

model RelationTemplate {
  id                               String                            @id @default(cuid())
  key                              String                            @unique
  name                             String
  description                      String?
  isDefault                        Boolean                           @default(false)
  createdAt                        DateTime                          @default(now())
  updatedAt                        DateTime                          @updatedAt
  status                           String                            @default("DRAFT")
  aiInstructions                   String?
  workspaceId                      String?
  aiEvents                         AIEvent[]
  communicationSessions            CommunicationSession[]
  formTemplates                    FormTemplate[]
  links                            GLink[]
  governedJourney                  GovernedJourney[]
  governedJourneyCreationRequest   GovernedJourneyCreationRequest?
  governedJourneyInvitations       GovernedJourneyInvitation[]
  governedMemoryCreationRequests   GovernedMemoryCreationRequest[]
  memoryDecisions                  GovernedMemoryDecision[]
  memoryDisputes                   GovernedMemoryDispute[]
  memoryEvents                     GovernedMemoryEvent[]
  memoryFacts                      GovernedMemoryFact[]
  memorySources                    GovernedMemorySource[]
  governedMemoryTransitionRequests GovernedMemoryTransitionRequest[]
  memoryValidations                GovernedMemoryValidation[]
  productFeedback                  ProductFeedback[]
  relationCases                    RelationCase[]
  workspace                        Workspace?                        @relation(fields: [workspaceId], references: [id])
  generations                      TemplateGeneration[]
  versions                         TemplateVersion[]
  trustPolicies                    TrustPolicy[]

  @@index([workspaceId])
}

model ProductFeedback {
  id          String                      @id @default(cuid())
  type        String
  message     String
  page        String?
  role        String?
  userId      String?
  caseId      String?
  templateId  String?
  browserInfo Json?
  environment String?
  status      ProductFeedbackStatus       @default(NEW)
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt
  resolvedAt  DateTime?
  adminNotes  String?
  case        RelationCase?               @relation(fields: [caseId], references: [id])
  template    RelationTemplate?           @relation(fields: [templateId], references: [id])
  user        User?                       @relation(fields: [userId], references: [id])
  attachments ProductFeedbackAttachment[]

  @@index([status, createdAt])
  @@index([type, createdAt])
  @@index([userId])
  @@index([caseId])
  @@index([templateId])
}

model ProductFeedbackAttachment {
  id         String          @id @default(cuid())
  feedbackId String
  fileName   String
  fileUrl    String
  mimeType   String
  fileSize   Int
  width      Int?
  height     Int?
  annotation Json?
  createdAt  DateTime        @default(now())
  feedback   ProductFeedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@index([feedbackId])
  @@index([createdAt])
}

model TemplateGeneration {
  id                 String               @id @default(cuid())
  createdById        String
  templateId         String?
  inputDescription   String
  language           String               @default("fr")
  output             Json
  provider           String
  model              String?
  promptVersion      String
  status             String               @default("GENERATED")
  validatedAt        DateTime?
  createdAt          DateTime             @default(now())
  aiEventId          String?              @unique
  parentGenerationId String?
  proposalVersion    Int                  @default(1)
  revisionFeedback   String?
  changes            Json?
  aiEvent            AIEvent?             @relation(fields: [aiEventId], references: [id])
  createdBy          User                 @relation(fields: [createdById], references: [id], onDelete: Cascade)
  parentGeneration   TemplateGeneration?  @relation("TemplateGenerationRevisions", fields: [parentGenerationId], references: [id])
  revisions          TemplateGeneration[] @relation("TemplateGenerationRevisions")
  template           RelationTemplate?    @relation(fields: [templateId], references: [id])

  @@index([createdById, createdAt])
  @@index([templateId])
  @@index([parentGenerationId])
}

model TrustPolicy {
  id                      String                             @id @default(cuid())
  scope                   TrustPolicyScope
  templateId              String?
  gLinkId                 String?
  relationCaseId          String?
  accessMode              TrustPolicyAccessMode              @default(PUBLIC_LINK)
  candidateCanRead        Boolean                            @default(true)
  candidateCanWrite       Boolean                            @default(true)
  ownerCanRead            Boolean                            @default(true)
  ownerCanWrite           Boolean                            @default(true)
  requireCandidateEmail   Boolean                            @default(true)
  requireCandidateConsent Boolean                            @default(false)
  allowDocuments          Boolean                            @default(true)
  candidateTokenTtlDays   Int                                @default(30)
  status                  TrustPolicyStatus                  @default(ACTIVE)
  reason                  String?
  version                 Int                                @default(1)
  createdAt               DateTime                           @default(now())
  updatedAt               DateTime                           @updatedAt
  gLink                   GLink?                             @relation(fields: [gLinkId], references: [id])
  relationCase            RelationCase?                      @relation(fields: [relationCaseId], references: [id])
  template                RelationTemplate?                  @relation(fields: [templateId], references: [id])
