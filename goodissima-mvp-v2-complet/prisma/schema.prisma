  relationTemplateId String?
  relationTemplate   RelationTemplate? @relation(fields: [relationTemplateId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fields      FormField[]
  submissions FormSubmission[]
  governedJourneys GovernedJourney[]
  governedJourneyCreationRequest GovernedJourneyCreationRequest?
}

model GovernedJourney {
  id String @id @default(cuid())
  relationCaseId String?
  formTemplateId String?
  relationTemplateId String @unique
  createdFromTemplateVersionId String
  title String
  status GovernedJourneyStatus @default(DRAFT)
  version Int @default(1)
  authorityUserId String
  currentStepKey String?
  startedAt DateTime?
  suspendedAt DateTime?
  closedAt DateTime?
  cancelledAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  relationCase RelationCase? @relation(fields: [relationCaseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  authority User @relation(fields: [authorityUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  formTemplate FormTemplate? @relation(fields: [formTemplateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  relationTemplate RelationTemplate @relation(fields: [relationTemplateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdFromTemplateVersion TemplateVersion @relation(fields: [createdFromTemplateVersionId, relationTemplateId], references: [id, templateId], onDelete: Restrict, onUpdate: Restrict)
  events GovernedJourneyEvent[]
  memoryFacts GovernedMemoryFact[] @relation("MemoryFactGovernedJourney")
  memoryDecisions GovernedMemoryDecision[] @relation("MemoryDecisionGovernedJourney")
  memorySources GovernedMemorySource[] @relation("MemorySourceGovernedJourney")
  governedMemoryCreationRequests GovernedMemoryCreationRequest[]
  relationCaseContexts GovernedJourneyRelationCase[]
  creationRequest GovernedJourneyCreationRequest?

  @@unique([id, relationTemplateId])
  @@unique([id, relationCaseId])
  @@unique([id, relationCaseId, authorityUserId])
  @@index([relationCaseId, status, createdAt])
  @@index([relationCaseId, status, updatedAt])
  @@index([formTemplateId])
  @@index([authorityUserId, status])
}

model GovernedJourneyCreationRequest {
  id                 String   @id @default(cuid())
  requesterUserId    String
  requestKey         String
  requestFingerprint String
  workspaceScopeKey  String

  workspaceId        String?
  relationTemplateId String?  @unique
  formTemplateId     String?  @unique
  governedJourneyId  String?  @unique

  createdAt          DateTime @default(now())
  completedAt        DateTime?

  requester User @relation("GovernedJourneyCreationRequestRequester", fields: [requesterUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  relationTemplate RelationTemplate? @relation(fields: [relationTemplateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  formTemplate FormTemplate? @relation(fields: [formTemplateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  governedJourney GovernedJourney? @relation(fields: [governedJourneyId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([requesterUserId, requestKey])
  @@index([requesterUserId, createdAt])
  @@index([workspaceId, createdAt])
}

model GovernedMemoryCreationRequest {
  id String @id @default(cuid())
  requesterUserId String
  requestKey String
  requestFingerprint String
  category GovernedMemoryCreationCategory
  relationTemplateId String
  governedJourneyId String
  relationCaseId String?
  factId String? @unique
  decisionId String? @unique
  sourceId String? @unique
  createdAt DateTime @default(now())
  completedAt DateTime?

  requester User @relation("GovernedMemoryCreationRequestRequester", fields: [requesterUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  relationTemplate RelationTemplate @relation(fields: [relationTemplateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  governedJourney GovernedJourney @relation(fields: [governedJourneyId, relationTemplateId], references: [id, relationTemplateId], onDelete: Restrict, onUpdate: Restrict)
  relationCase RelationCase? @relation(fields: [relationCaseId, relationTemplateId], references: [id, templateId], onDelete: Restrict, onUpdate: Restrict)
  fact GovernedMemoryFact? @relation(fields: [factId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  decision GovernedMemoryDecision? @relation(fields: [decisionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  source GovernedMemorySource? @relation(fields: [sourceId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([requesterUserId, requestKey])
  @@index([governedJourneyId, createdAt])
  @@index([relationTemplateId, createdAt])
  @@index([relationCaseId, createdAt])
}

model GovernedJourneyRelationCase {
  governedJourneyId  String
  relationCaseId     String
  relationTemplateId String
  createdByUserId    String
  createdAt          DateTime @default(now())

  governedJourney GovernedJourney @relation(fields: [governedJourneyId, relationTemplateId], references: [id, relationTemplateId], onDelete: Restrict, onUpdate: Restrict)
  relationCase RelationCase @relation(fields: [relationCaseId, relationTemplateId], references: [id, templateId], onDelete: Restrict, onUpdate: Restrict)
  createdBy User @relation("GovernedJourneyRelationCaseCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([governedJourneyId, relationCaseId])
  @@unique([relationCaseId, relationTemplateId])
  @@index([relationTemplateId])
  @@index([createdByUserId, createdAt])
}

model GovernedJourneyEvent {
  id String @id @default(cuid())
  governedJourneyId String
  relationCaseId String
  type GovernedJourneyEventType
  actorUserId String
  authorityUserId String
  fromStatus GovernedJourneyStatus?
  toStatus GovernedJourneyStatus
  reason String?
  sequence Int
  occurredAt DateTime
  createdAt DateTime @default(now())

  governedJourney GovernedJourney @relation(fields: [governedJourneyId, relationCaseId, authorityUserId], references: [id, relationCaseId, authorityUserId], onDelete: Restrict, onUpdate: Restrict)
  actor User @relation("GovernedJourneyEventActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  memorySources GovernedMemorySource[] @relation("MemorySourceGovernedJourneyEvent")

  @@unique([id, governedJourneyId, relationCaseId])
  @@unique([governedJourneyId, sequence])
  @@index([governedJourneyId, occurredAt, id])
  @@index([relationCaseId, occurredAt, id])
}

model FormField {
  id String @id @default(cuid())

  formTemplateId String
  formTemplate   FormTemplate @relation(fields: [formTemplateId], references: [id], onDelete: Cascade)

  key   String
  label String

  type     String
  required Boolean @default(false)

  placeholder  String?
  defaultValue String?

  position Int @default(0)
  step     Int @default(1)

  options          Json?
  validationRules  Json?
  conditionalRules Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([formTemplateId, position])
}

model FormSubmission {
  id String @id @default(cuid())

  formTemplateId String
  formTemplate   FormTemplate @relation(fields: [formTemplateId], references: [id])

  caseId String?
  case   RelationCase? @relation(fields: [caseId], references: [id])

  answers Json

  createdAt DateTime @default(now())
}

model RelationEvent {
  id String @id @default(cuid())

  caseId String
  case   RelationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  type      String
  actorType String?
  actorId   String?

  payload Json?

  createdAt DateTime @default(now())

  @@index([caseId, createdAt])
}

model RelationAction {
  id String @id @default(cuid())

  relationCaseId String
  relationCase   RelationCase @relation(fields: [relationCaseId], references: [id], onDelete: Cascade)

  type String

  status String @default("PENDING")

  title       String
  description String?

  payload Json?

  createdByRole String

  completedAt DateTime?

  createdAt DateTime @default(now())

  @@index([relationCaseId, status])
  @@index([relationCaseId, createdAt])
}

model Message {
  id          String     @id @default(cuid())
  caseId      String
  senderType  SenderType
  senderEmail String
  body        String
  createdAt   DateTime   @default(now())

  relationCase RelationCase @relation(fields: [caseId], references: [id])
}

model Document {
  id              String   @id @default(cuid())
  caseId          String
  uploadedByEmail String
  fileName        String
  fileUrl         String
  mimeType        String?
  createdAt       DateTime @default(now())

  relationCase RelationCase @relation(fields: [caseId], references: [id])
}

model AuditLog {
  id         String   @id @default(cuid())
  caseId     String?
  actorEmail String?
  eventType  String
  metadata   Json?
  createdAt  DateTime @default(now())

  relationCase RelationCase? @relation(fields: [caseId], references: [id])
}
