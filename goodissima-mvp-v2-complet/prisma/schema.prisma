generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum LinkStatus {
  ACTIVE
  DISABLED
  EXPIRED
  ARCHIVED
}

enum CaseStatus {
  NEW
  IN_DISCUSSION
  VALIDATED
  REFUSED
  CLOSED
}

enum RelationPriority {
  NORMAL
  HIGH
  URGENT
}

enum RelationStatus {
  NEW
  WAITING_CANDIDATE
  WAITING_OWNER
  REVIEWING
  VALIDATED
  REJECTED
  CLOSED
  ARCHIVED
}

enum RelationGovernanceStatus {
  ACTIVE
  SUSPENDED
  CLOSED
  BLOCKED
}

enum MatchingRunStatus {
  PREPARED
  RUNNING
  RESULTS_AVAILABLE
  FAILED
  CLOSED
}

enum MatchingResultStatus {
  AVAILABLE
  SELECTED
  DISMISSED
  LINKED
}

enum SenderType {
  OWNER
  CANDIDATE
  SYSTEM
}

enum AccessInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum TrustPolicyScope {
  TEMPLATE
  GLINK
  RELATION_CASE
}

enum TrustPolicyAccessMode {
  PUBLIC_LINK
  INVITED_OWNER_ONLY
  TOKEN_HOLDER
  MANUAL_REVIEW
}

enum TrustPolicyStatus {
  ACTIVE
  DISABLED
}

enum CredentialTypeStatus {
  ACTIVE
  DISABLED
}

enum TrustedOrganizationStatus {
  PENDING
  TRUSTED
  SUSPENDED
  REVOKED
}

enum TrustConnectorStatus {
  ACTIVE
  DISABLED
}

enum TrustConnectorProviderType {
  DEMO
  GOVERNMENT
  EUROPEAN_WALLET
  BANK
  INSURANCE
  EDUCATION
  PROFESSIONAL_BODY
  OTHER
}

enum IdentityType {
  PERSON
  ORGANIZATION
}

enum IdentityStatus {
  UNVERIFIED
  VERIFIED
  SUSPENDED
  REVOKED
}

enum RepresentationType {
  PROFESSIONAL
  ORGANIZATION_REPRESENTATIVE
  ASSOCIATION
  PRIVATE
  OTHER
}

enum RepresentationStatus {
  ACTIVE
  HIDDEN
  ARCHIVED
}

enum RepresentationRelationshipPolicy {
  OPEN
  MESSAGE_ONLY
  CLOSED
}

enum RepresentationVisibility {
  PRIVATE
  DISCOVERABLE
}

enum ContactRequestStatus {
  PENDING
  ACCEPTED
  REFUSED
  DEFERRED
  CANCELLED
  EXPIRED
}

enum ContactRequestChannel {
  MESSAGE
  VOICE
  VIDEO
}

enum ContactRequestEventType {
  CREATED
  VIEWED_BY_TARGET
  ACCEPTED
  REFUSED
  DEFERRED
  RESUMED
  CANCELLED
  EXPIRED
}

enum RepresentationContactStatus {
  ACTIVE
  ARCHIVED
  REVOKED
}

enum RepresentationContactEventType {
  CREATED
  ARCHIVED
  RESTORED
}

enum TrustCredentialStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
  REVOKED
}

enum TrustClaimType {
  STRING
  BOOLEAN
  INTEGER
  DECIMAL
  DATE
  DATETIME
  JSON
}

enum TrustAdmissionTokenStatus {
  ACTIVE
  USED
  EXPIRED
  REVOKED
}

enum TrustAdmissionTokenPurpose {
  TRUST_ADMISSION
}

enum LinkAdmissionMode {
  OPEN
  VERIFIED_ONLY
}

enum ProductFeedbackStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  IGNORED
}

enum GovernedJourneyInvitationRole {
  EXPERT
  JUDGE
  THIRD_PARTY
  ASSOCIATION
  FAMILY
  OBSERVER
  OTHER
}

enum GovernedJourneyInvitationStatus {
  PREPARED
  ACTIVE
  REVOKED
  EXPIRED
}

enum GovernedJourneyStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  CLOSED
  CANCELLED
}

enum GovernedJourneyEventType {
  CREATED
  ACTIVATED
  SUSPENDED
  RESUMED
  CLOSED
  CANCELLED
}

enum WorkspaceKind {
  GOVERNANCE
  RELATION
  MIXED
}

enum WorkspaceStatus {
  ACTIVE
  ARCHIVED
}

enum WorkspaceCategory {
  PROFESSIONAL
  PRIVATE
  FAMILY
  ASSOCIATION
  PROJECT
  CLIENT
  OTHER
}

enum PortfolioKind {
  JUDICIAL
  PROFESSIONAL
  ASSOCIATION
  FAMILY
  PROJECT
  PERSONAL
  OTHER
}

enum PortfolioStatus {
  ACTIVE
  ARCHIVED
}

enum CommunicationChannelType {
  VOICE_IP
  VIDEO_IP
  SCREEN_SHARE
}

enum CommunicationSessionStatus {
  REQUESTED
  PREPARED_NOT_STARTED
  CANCELLED
  COMPLETED
}

enum CommunicationProvider {
  NONE
  MANUAL_EXTERNAL
  LIVEKIT_PENDING
}

enum GovernedMeetingParticipantStatus {
  AUTHORIZED
  REMOVED
}

enum GovernedMemoryFactStatus {
  PROPOSED
  ESTABLISHED
  DISPUTED
  SUPERSEDED
}

enum GovernedMemoryEvidenceLevel {
  DECLARED
  SUPPORTED
  CORROBORATED
  CONTESTED
}

enum GovernedMemoryDecisionStatus {
  DRAFT
  VALIDATED
  SUPERSEDED
  CANCELLED
}

enum GovernedMemorySourceKind {
  DOCUMENT
  DOCUMENT_VERSION
  FORM_SUBMISSION
  MESSAGE_EXCERPT
  SYSTEM_EVENT
  HUMAN_DECLARATION
  VALIDATED_SYNTHESIS
  EXTERNAL_IMPORT
}

enum GovernedMemorySourceStatus {
  ACTIVE
  ARCHIVED
  RESTRICTED
  EXPIRED
  ANONYMIZED
  DELETED
  LEGAL_HOLD
}

enum GovernedMemoryValidationDecision {
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  WITH_RESERVATIONS
}

enum GovernedMemoryDisputeStatus {
  OPEN
  RESOLVED
  MAINTAINED
  WITHDRAWN
}

enum GovernedMemoryRelationType {
  SUPPORTED_BY
  DERIVED_FROM
  REPLACES
  CORRECTS
  CANCELS
  COMPLEMENTS
  CONTESTS
  VALIDATES
  SUMMARIZES
}

enum GovernedMemoryPermission {
  VIEW_MEMORY
  VIEW_SOURCES
  REGISTER_SOURCE
  PROPOSE_FACT
  ESTABLISH_FACT
  DISPUTE_FACT
  RECORD_DECISION
  VALIDATE_DECISION
  VALIDATE_SYNTHESIS
  MANAGE_MEMORY_ACCESS
  PROMOTE_PRIVATE_SOURCE
}

enum GovernedMemoryCreationCategory {
  FACT
  DECISION
  SOURCE
}

enum GovernedMemorySubjectType {
  USER
  REPRESENTATION
}

enum GovernedMemoryTargetType {
  FACT
  DECISION
  SOURCE
}

enum GovernedMemoryEventType {
  FACT_PROPOSED
  FACT_ESTABLISHED
  FACT_DISPUTED
  FACT_SUPERSEDED
  DECISION_RECORDED
  DECISION_VALIDATED
  DECISION_SUPERSEDED
  DECISION_CANCELLED
  SOURCE_REGISTERED
  SOURCE_PROMOTED
  SOURCE_RESTRICTED
  SOURCE_DELETED
  ACCESS_GRANTED
  ACCESS_REVOKED
  VALIDATION_RECORDED
  DISPUTE_OPENED
  DISPUTE_RESOLVED
}

enum GovernedMemoryActorType {
  HUMAN
  SYSTEM
}

enum GovernedMemoryRole {
  MEMORY_STEWARD
  MEMORY_DELEGATE
}

model User {
  id                   String   @id @default(cuid())
  email                String   @unique
  name                 String?
  role                 String   @default("OWNER")
  goodissimaIdentityId String?  @unique
  createdAt            DateTime @default(now())

  links                   GLink[]
  cases                   RelationCase[]              @relation("OwnerCases")
  matchingRuns            MatchingRun[]                @relation("MatchingRunOwner")
  portfolios              Portfolio[]                  @relation("OwnerPortfolios")
  workspaces              Workspace[]                 @relation("OwnerWorkspaces")
  communicationSessions   CommunicationSession[]
  authorizedMeetingParticipants GovernedMeetingParticipant[] @relation("MeetingParticipantAuthorizer")
  goodissimaIdentity      GoodissimaIdentity?         @relation(fields: [goodissimaIdentityId], references: [id], onDelete: SetNull)
  notificationPreferences UserNotificationPreference?
  templateGenerations     TemplateGeneration[]
  templateCriticReports   TemplateCriticReport[]
  templateOptimizations   TemplateOptimization[]
  aiEvents                AIEvent[]
  manualTemplateEditAudits ManualTemplateEditAudit[]
  productFeedback         ProductFeedback[]
  representations         Representation[]             @relation("OwnerRepresentations")
  requestedContactRequests ContactRequest[]            @relation("ContactRequestRequester")
  targetedContactRequests  ContactRequest[]            @relation("ContactRequestTarget")
  decidedContactRequests   ContactRequest[]            @relation("ContactRequestDecider")
  contactRequestEvents     ContactRequestEvent[]
  representationContacts   RepresentationContact[]      @relation("RepresentationContactOwner")
  representationContactEvents RepresentationContactEvent[]
  authoredMemoryFacts GovernedMemoryFact[] @relation("MemoryFactAuthor")
  establishedMemoryFacts GovernedMemoryFact[] @relation("MemoryFactEstablisher")
  decidedMemoryDecisions GovernedMemoryDecision[] @relation("MemoryDecisionDecider")
  validatedMemoryDecisions GovernedMemoryDecision[] @relation("MemoryDecisionValidator")
  promotedMemorySources GovernedMemorySource[] @relation("MemorySourcePromoter")
  createdMemoryRelations GovernedMemoryRelation[]
  memoryValidations GovernedMemoryValidation[]
  raisedMemoryDisputes GovernedMemoryDispute[] @relation("MemoryDisputeRaiser")
  resolvedMemoryDisputes GovernedMemoryDispute[] @relation("MemoryDisputeResolver")
  subjectMemoryGrants GovernedMemoryAccessGrant[] @relation("MemoryGrantUserSubject")
  grantedMemoryGrants GovernedMemoryAccessGrant[] @relation("MemoryGrantGranter")
  revokedMemoryGrants GovernedMemoryAccessGrant[] @relation("MemoryGrantRevoker")
  memoryEvents GovernedMemoryEvent[]
  memoryRoleAssignments GovernedMemoryRoleAssignment[] @relation("MemoryRoleSubject")
  assignedMemoryRoles GovernedMemoryRoleAssignment[] @relation("MemoryRoleAssigner")
  revokedMemoryRoles GovernedMemoryRoleAssignment[] @relation("MemoryRoleRevoker")
  governedJourneys GovernedJourney[]
  governedJourneyEvents GovernedJourneyEvent[] @relation("GovernedJourneyEventActor")
  createdGovernedJourneyRelationCaseContexts GovernedJourneyRelationCase[] @relation("GovernedJourneyRelationCaseCreator")
  governedJourneyCreationRequests GovernedJourneyCreationRequest[] @relation("GovernedJourneyCreationRequestRequester")
  governedMemoryCreationRequests GovernedMemoryCreationRequest[] @relation("GovernedMemoryCreationRequestRequester")

  @@unique([id, goodissimaIdentityId])
}

model Portfolio {
  id          String          @id @default(cuid())
  ownerId     String
  slug        String
  name        String
  description String?
  kind        PortfolioKind   @default(OTHER)
  status      PortfolioStatus @default(ACTIVE)
  metadata    Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  owner      User        @relation("OwnerPortfolios", fields: [ownerId], references: [id], onDelete: Cascade)
  workspaces Workspace[]

  @@unique([ownerId, slug])
  @@index([ownerId, status, createdAt])
  @@index([ownerId, kind, status])
}

model Workspace {
  id          String          @id @default(cuid())
  ownerId     String
  portfolioId String?
  slug        String
  name        String
  description String?
  kind        WorkspaceKind   @default(GOVERNANCE)
  category    WorkspaceCategory @default(OTHER)
  status      WorkspaceStatus @default(ACTIVE)
  metadata    Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  owner             User               @relation("OwnerWorkspaces", fields: [ownerId], references: [id], onDelete: Cascade)
  portfolio         Portfolio?         @relation(fields: [portfolioId], references: [id], onDelete: SetNull)
  relationTemplates RelationTemplate[]
  relationCases     RelationCase[]
  links             GLink[]
  communicationSessions CommunicationSession[]
  governedJourneyInvitations GovernedJourneyInvitation[]
  governedJourneyCreationRequests GovernedJourneyCreationRequest[]

  @@unique([ownerId, slug])
  @@index([portfolioId])
  @@index([ownerId, status, createdAt])
  @@index([ownerId, category, status])
  @@index([kind, status])
}

model GovernedJourneyInvitation {
  id String @id @default(cuid())
  ownerId String
  workspaceId String?
  relationTemplateId String
  relationCaseId String?
  displayName String
  role GovernedJourneyInvitationRole
  status GovernedJourneyInvitationStatus @default(ACTIVE)
  accessTokenHash String @unique
  accessTokenExpiresAt DateTime
  revokedAt DateTime?
  acceptedAt DateTime?
  lastAccessedAt DateTime?
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  relationTemplate RelationTemplate @relation(fields: [relationTemplateId], references: [id], onDelete: Cascade)
  relationCase RelationCase? @relation(fields: [relationCaseId], references: [id], onDelete: SetNull)
  meetingParticipants GovernedMeetingParticipant[]

  @@index([ownerId, relationTemplateId, status])
  @@index([accessTokenExpiresAt, status])
}

model CommunicationSession {
  id        String @id @default(cuid())
  ownerId   String
  workspaceId String?
  relationTemplateId String?
  relationCaseId String?
  channelType CommunicationChannelType
  provider CommunicationProvider @default(NONE)
  status CommunicationSessionStatus @default(PREPARED_NOT_STARTED)
  title String
  purpose String?
  note String?
  externalUrl String?
  scheduledAt DateTime?
  expiresAt DateTime?
  transcriptionRequested Boolean @default(false)
  transcriptionConsented Boolean @default(false)
  recordingEnabled Boolean @default(false)
  automaticNotificationSent Boolean @default(false)
  tokenGenerated Boolean @default(false)
  accessOpened Boolean @default(false)
  workflowStarted Boolean @default(false)
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  relationTemplate RelationTemplate? @relation(fields: [relationTemplateId], references: [id], onDelete: SetNull)
  relationCase RelationCase? @relation(fields: [relationCaseId], references: [id], onDelete: SetNull)
  meetingParticipants GovernedMeetingParticipant[]

  @@index([ownerId, status, createdAt])
  @@index([workspaceId, status])
  @@index([relationTemplateId, status])
  @@index([relationCaseId, status])
  @@index([channelType, status])
}

model GovernedMeetingParticipant {
  id String @id @default(cuid())
  communicationSessionId String
  governedJourneyInvitationId String
  status GovernedMeetingParticipantStatus @default(AUTHORIZED)
  authorizedAt DateTime @default(now())
  removedAt DateTime?
  authorizedById String?
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  communicationSession CommunicationSession @relation(fields: [communicationSessionId], references: [id], onDelete: Cascade)
  governedJourneyInvitation GovernedJourneyInvitation @relation(fields: [governedJourneyInvitationId], references: [id], onDelete: Cascade)
  authorizedBy User? @relation("MeetingParticipantAuthorizer", fields: [authorizedById], references: [id], onDelete: SetNull)

  @@unique([communicationSessionId, governedJourneyInvitationId])
  @@index([governedJourneyInvitationId, status])
}

model AccessInvitation {
  id              String                 @id @default(cuid())
  email           String                 @unique
  invitedByUserId String?
  status          AccessInvitationStatus @default(PENDING)
  note            String?
  token           String?
  expiresAt       DateTime?
  acceptedAt      DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([status, createdAt])
}

model UserNotificationPreference {
  id     String @id @default(cuid())
  userId String @unique

  emailNotificationsEnabled Boolean @default(false)
  newMessagesEnabled        Boolean @default(false)
  newRequestsEnabled        Boolean @default(false)
  newDocumentsEnabled       Boolean @default(false)
  validationsEnabled        Boolean @default(false)
  relationalPrivacyEnabled  Boolean @default(true)
  pseudonymizationEnabled   Boolean @default(true)
  frequency                 String  @default("IMMEDIATE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GLink {
  id                String     @id @default(cuid())
  ownerId           String
  workspaceId       String?
  templateId        String?
  templateVersionId String?
  slug              String     @unique
  title             String
  city              String?
  description       String?
  rules             Json?
  status            LinkStatus @default(ACTIVE)
  admissionMode     LinkAdmissionMode @default(OPEN)
  createdAt         DateTime   @default(now())
  expiresAt         DateTime?

  owner                User                  @relation(fields: [ownerId], references: [id])
  workspace            Workspace?            @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  template             RelationTemplate?     @relation(fields: [templateId], references: [id])
  templateVersion      TemplateVersion?      @relation(fields: [templateVersionId], references: [id])
  cases                RelationCase[]
  trustPolicies        TrustPolicy[]
  trustAdmissionTokens TrustAdmissionToken[]
  matchingRuns         MatchingRun[]    @relation("MatchingRunSourceGLink")
  matchingResults      MatchingResult[] @relation("MatchingResultTargetGLink")

  @@index([workspaceId])
}

model RelationCase {
  id                                 String                   @id @default(cuid())
  gLinkId                            String
  ownerId                            String
  workspaceId                        String?
  templateId                         String?
  candidateIdentityId                String?
  candidateAccessToken               String                   @unique
  candidateAccessExpiresAt           DateTime?
  candidateAccessRevokedAt           DateTime?
  candidateName                      String
  candidateEmail                     String
  candidateEmailNotificationsEnabled Boolean                  @default(false)
  matchingEnabled                    Boolean                  @default(false)
  embeddingStatus                    String                   @default("fresh")
  embeddingUpdatedAt                 DateTime?
  priority                           RelationPriority         @default(NORMAL)
  status                             RelationStatus           @default(NEW)
  governanceStatus                   RelationGovernanceStatus @default(ACTIVE)
  governanceUpdatedAt                DateTime?
  governanceReason                   String?
  currentStep                        String?                  @default("CONVERSATION")
  createdAt                          DateTime                 @default(now())
  closedAt                           DateTime?

  gLink             GLink               @relation(fields: [gLinkId], references: [id])
  owner             User                @relation("OwnerCases", fields: [ownerId], references: [id])
  workspace         Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  governedJourneyInvitations GovernedJourneyInvitation[]
  governedJourneys GovernedJourney[]
  governedJourneyContexts GovernedJourneyRelationCase[]
  template          RelationTemplate?   @relation(fields: [templateId], references: [id])
  candidateIdentity GoodissimaIdentity? @relation(fields: [candidateIdentityId], references: [id], onDelete: SetNull)
  messages          Message[]
  documents         Document[]
  auditLogs         AuditLog[]
  relationEvents    RelationEvent[]
  relationActions   RelationAction[]
  formSubmissions   FormSubmission[]
  aiEvents          AIEvent[]
  embeddings        RelationEmbedding[]
  embeddingJobs     EmbeddingJob[]
  trustPolicies     TrustPolicy[]
  productFeedback   ProductFeedback[]
  communicationSessions CommunicationSession[]
  matchingResults   MatchingResult[]
  memoryFacts GovernedMemoryFact[]
  memoryDecisions GovernedMemoryDecision[]
  memorySources GovernedMemorySource[]
  memoryRelations GovernedMemoryRelation[]
  memoryValidations GovernedMemoryValidation[]
  memoryDisputes GovernedMemoryDispute[]
  memoryAccessGrants GovernedMemoryAccessGrant[]
  memoryEvents GovernedMemoryEvent[]
  memoryRoleAssignments GovernedMemoryRoleAssignment[]
  governedMemoryCreationRequests GovernedMemoryCreationRequest[]

  @@unique([id, ownerId])
  @@unique([id, templateId])

  @@index([governanceStatus])
  @@index([candidateIdentityId])
  @@index([workspaceId])
}

model MatchingRun {
  id               String            @id @default(cuid())
  gLinkId          String
  ownerId          String
  status           MatchingRunStatus @default(PREPARED)
  isPaused         Boolean           @default(false)
  engineVersion    String
  criteriaSnapshot Json
  startedAt        DateTime?
  completedAt      DateTime?
  failedAt         DateTime?
  pausedAt         DateTime?
  closedAt         DateTime?
  failureCode      String?
  idempotencyKey   String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  gLink   GLink            @relation("MatchingRunSourceGLink", fields: [gLinkId], references: [id], onDelete: Restrict)
  owner   User             @relation("MatchingRunOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  results MatchingResult[]

  @@index([gLinkId, createdAt])
  @@index([ownerId, status])
  @@index([ownerId, isPaused])
  @@unique([ownerId, idempotencyKey])
}

model MatchingResult {
  id             String               @id @default(cuid())
  runId          String
  targetGLinkId  String
  status         MatchingResultStatus @default(AVAILABLE)
  explanation    Json
  internalRank   Int?
  selectedAt     DateTime?
  dismissedAt    DateTime?
  linkedAt       DateTime?
  relationCaseId String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  run          MatchingRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  targetGLink  GLink         @relation("MatchingResultTargetGLink", fields: [targetGLinkId], references: [id], onDelete: Restrict)
  relationCase RelationCase? @relation(fields: [relationCaseId], references: [id], onDelete: SetNull)

  @@unique([runId, targetGLinkId])
  @@index([runId, status])
  @@index([targetGLinkId])
  @@index([relationCaseId])
}

model EmbeddingJob {
  id String @id @default(cuid())

  relationCaseId String
  relationCase   RelationCase @relation(fields: [relationCaseId], references: [id], onDelete: Cascade)

  status      String  @default("pending")
  triggerType String
  attempts    Int     @default(0)
  lastError   String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  processedAt DateTime?

  @@index([status, createdAt])
  @@index([relationCaseId, status])
}

model RelationEmbedding {
  id String @id @default(cuid())

  relationCaseId String
  relationCase   RelationCase @relation(fields: [relationCaseId], references: [id], onDelete: Cascade)

  embeddingType String
  contentHash   String
  vector        Unsupported("vector")?

  createdAt DateTime @default(now())

  @@index([relationCaseId, embeddingType])
  @@index([contentHash])
}

model RelationTemplate {
  id             String  @id @default(cuid())
  workspaceId    String?
  key            String  @unique
  name           String
  description    String?
  isDefault      Boolean @default(false)
  status         String  @default("DRAFT")
  aiInstructions String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace     Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  relationCases RelationCase[]
  links         GLink[]
  formTemplates FormTemplate[]
  versions      TemplateVersion[]
  trustPolicies TrustPolicy[]
  generations   TemplateGeneration[]
  aiEvents      AIEvent[]
  productFeedback ProductFeedback[]
  communicationSessions CommunicationSession[]
  governedJourneyInvitations GovernedJourneyInvitation[]
  governedJourney GovernedJourney?
  governedJourneyCreationRequest GovernedJourneyCreationRequest?
  memoryFacts GovernedMemoryFact[]
  memoryDecisions GovernedMemoryDecision[]
  memorySources GovernedMemorySource[]
  governedMemoryCreationRequests GovernedMemoryCreationRequest[]

  @@index([workspaceId])
}

model ProductFeedback {
  id           String                @id @default(cuid())
  type         String
  message      String
  page         String?
  role         String?
  userId       String?
  caseId       String?
  templateId   String?
  browserInfo  Json?
  environment  String?
  status       ProductFeedbackStatus @default(NEW)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  resolvedAt   DateTime?
  adminNotes   String?

  user     User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  case     RelationCase?     @relation(fields: [caseId], references: [id], onDelete: SetNull)
  template RelationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  attachments ProductFeedbackAttachment[]

  @@index([status, createdAt])
  @@index([type, createdAt])
  @@index([userId])
  @@index([caseId])
  @@index([templateId])
}

model ProductFeedbackAttachment {
  id         String          @id @default(cuid())
  feedbackId String
  fileName   String
  fileUrl    String
  mimeType   String
  fileSize   Int
  width      Int?
  height     Int?
  annotation Json?
  createdAt  DateTime        @default(now())

  feedback ProductFeedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@index([feedbackId])
  @@index([createdAt])
}

model TemplateGeneration {
  id String @id @default(cuid())

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  templateId String?
  template   RelationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  aiEventId String?  @unique
  aiEvent   AIEvent? @relation(fields: [aiEventId], references: [id], onDelete: SetNull)

  parentGenerationId String?
  parentGeneration   TemplateGeneration?  @relation("TemplateGenerationRevisions", fields: [parentGenerationId], references: [id], onDelete: SetNull)
  revisions          TemplateGeneration[] @relation("TemplateGenerationRevisions")

  inputDescription String
  language         String    @default("fr")
  output           Json
  provider         String
  model            String?
  promptVersion    String
  proposalVersion  Int       @default(1)
  revisionFeedback String?
  changes          Json?
  status           String    @default("GENERATED")
  validatedAt      DateTime?
